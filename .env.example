# ─────────────────────────────────────────────────────────────────────────────
# Patrícia Faro · Low Ticket (GAS = Guia da Avaliação Segura)
# Marca/conta/filtro já estão como default no lib/config.ts, então só as chaves
# abaixo (segredos/infra) precisam ser setadas na Vercel deste projeto.
# ─────────────────────────────────────────────────────────────────────────────

# ── (opcional — só se quiser sobrescrever o default do config.ts) ──
# APP_NAME="Patrícia Faro · Low Ticket"
# META_ACCOUNT_ID="939669440392208"
# CAMPAIGN_FILTER="LT_GAS"
# SCOPE_LABEL="LOW TICKET · GAS"
# CPA_TARGET="90"
# TAX_RATE="0.1215"

# ── Supabase (banco de vendas Eduzz) — projeto NOVO, dedicado desta cliente ──
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# ── Eduzz (webhook) — conta Eduzz da Patrícia (produto "Guia da Avaliação Segura") ──
EDUZZ_WEBHOOK_SECRET="invente_uma_senha"   # vai no fim da URL: /api/eduzz/webhook/<secret>

# ── Admin (tela /admin p/ subir planilha) ──
ADMIN_PASSWORD="invente_uma_senha"

# ── Windsor (cron diário de gasto) — mesma chave da agência ──
WINDSOR_API_KEY="a_chave_windsor_da_agencia"

# ── Cron + auto-commit do dataset ──
CRON_SECRET="cron_xxxxx"
GITHUB_TOKEN="ghp_xxxxx"                    # token clássico (repo scope)
GITHUB_REPO="agneer/patricia-faro-dash"     # repo desta cliente

# ── Meta Marketing API — FONTE PRINCIPAL do gasto (ao vivo, todo o histórico) ──
# System user com ads_read na conta 939669440392208. Ausente → só o snapshot.
META_ACCESS_TOKEN="EAAB...token_system_user..."
# META_API_VERSION="v23.0"                 # opcional; só se a Meta descontinuar a versão
